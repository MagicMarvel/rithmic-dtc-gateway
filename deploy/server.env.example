# Keep both unauthenticated listeners on loopback. Reach them through SSH tunnels
# or place an authenticated reverse proxy/VPN in front of them.
DTC_LISTEN_ADDR=127.0.0.1:11099
OPTIONS_HTTP_LISTEN_ADDR=127.0.0.1:11100

RITHMIC_DTC_SYMBOL=ESU6
RITHMIC_DTC_EXCHANGE=CME
RITHMIC_ENABLE_TRADING=false

RITHMIC_ENABLE_OPTIONS=true
RITHMIC_OPTIONS_ROOT=ES
RITHMIC_OPTIONS_EXCHANGE=CME
RITHMIC_OPTIONS_UNDERLYING_SYMBOL=ESU6
OPTIONS_MAX_EXPIRATIONS=2
OPTIONS_STRIKES_EACH_SIDE=12
OPTIONS_MAX_CONTRACTS=64
OPTIONS_SNAPSHOT_SECS=3
OPTIONS_RISK_FREE_RATE=0.05
OPTIONS_DATA_DIR=/var/lib/rithmic-dtc-bridge/data/options
# 144 30-minute chunks provide roughly 72 trading hours of source bars while
# returning freed replay pages to Linux after every chunk.
OPTIONS_HISTORY_CHUNKS=144
OPTIONS_HISTORY_CHUNK_MINUTES=30
OPTIONS_HISTORY_MAX_RSS_MB=450
