[Unit]
Description=TLS public gateway for Rithmic Options dashboard
After=network-online.target rithmic-dtc-bridge.service
Wants=network-online.target

[Service]
Type=simple
User=rithmic
Group=rithmic
ExecStart=/usr/bin/socat OPENSSL-LISTEN:2053,reuseaddr,fork,cert=/var/lib/rithmic-dtc-bridge/public.crt,key=/var/lib/rithmic-dtc-bridge/public.key,verify=0,openssl-min-proto-version=TLS1.2 TCP:127.0.0.1:11100
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/rithmic-dtc-bridge/public.crt /var/lib/rithmic-dtc-bridge/public.key

[Install]
WantedBy=multi-user.target
