# Never commit real credentials. Copy this file to .env or export the variables.
RITHMIC_ENV=demo
RITHMIC_APP_NAME=rithmic_dtc_bridge_probe
RITHMIC_APP_VERSION=1

# Browser terminal. Market data and history always use the server credentials
# below and those credentials are never exposed through the browser API.
TERMINAL_HTTP_LISTEN_ADDR=127.0.0.1:11200
# An active member session is required for every terminal API and WebSocket.
# Configure either one account with the two variables below, or multiple
# accounts with TERMINAL_MEMBERS_JSON. Keep these server-side only.
TERMINAL_MEMBER_USER=
TERMINAL_MEMBER_PASSWORD=
# Optional Unix expiry timestamp for the single account.
# TERMINAL_MEMBER_EXPIRES_AT=1798761600
# Example multi-account value (active and expiresAt are optional):
# TERMINAL_MEMBERS_JSON=[{"username":"member@example.com","password":"change-me","active":true,"expiresAt":1798761600}]
# Sessions default to 12 hours; accepted range is 5 minutes to 30 days.
TERMINAL_MEMBER_SESSION_SECS=43200
# Set true when the terminal is served over HTTPS.
TERMINAL_COOKIE_SECURE=false
# The account drawer configures a separate, order-only Rithmic login. Its saved
# file does not override or reconnect the server market/history data source.
# RITHMIC_TRADING_CONNECTION_FILE=data/rithmic-trading-connection.json

# Demo credentials and endpoints supplied by Rithmic or your broker.
RITHMIC_DEMO_USER=
RITHMIC_DEMO_PW=
RITHMIC_DEMO_URL=
RITHMIC_DEMO_ALT_URL=
# A maintenance rejection retries at 10s, 20s, 40s, and so on, capped at 2m.
RITHMIC_MAINTENANCE_RETRY_INITIAL_SECS=10
RITHMIC_MAINTENANCE_RETRY_MAX_SECS=120
# Optional; rithmic-rs defaults Demo to "Rithmic Paper Trading".
# RITHMIC_DEMO_SYSTEM_NAME="Rithmic Paper Trading"

# Personal Paper trading is opt-in. The browser supplies its own login and
# Account/FCM/IB identifiers; the server environment values below are only
# optional defaults for non-terminal tools. Live orders remain hard-rejected.
RITHMIC_ENABLE_TRADING=false
RITHMIC_DEMO_ACCOUNT_ID=
RITHMIC_DEMO_FCM_ID=
RITHMIC_DEMO_IB_ID=
# Safety defaults: one contract maximum, market orders rejected.
RITHMIC_MAX_ORDER_QUANTITY=1
RITHMIC_ALLOW_MARKET_ORDERS=false
# Optional Paper safety: ask Rithmic to auto-cancel every new order after N seconds.
# RITHMIC_ORDER_SAFETY_CANCEL_SECS=30

# Historical requests are not capped locally; Sierra's requested range is honored.
# Tick history is fetched and streamed in bounded chunks to avoid Sierra's timeout.
RITHMIC_HISTORY_TICK_CHUNK_HOURS=6
# Set this to a positive number only if a local timeout is desired.
RITHMIC_HISTORY_REQUEST_TIMEOUT_SECS=0
# Probe a currently trading contract for meaningful live validation.
RITHMIC_PROBE_SYMBOL=ESZ6
RITHMIC_PROBE_EXCHANGE=CME
RITHMIC_PROBE_TIMEOUT_SECS=45
# Optional separate contract served to Sierra; defaults to the probe values.
# RITHMIC_DTC_SYMBOL=ESZ6
# RITHMIC_DTC_EXCHANGE=CME
# DTC-only account router and local management UI. If DTC_ADMIN_TOKEN is
# omitted, a random token is printed at startup. Passwords are never returned.
DTC_ADMIN_LISTEN_ADDR=127.0.0.1:11101
# DTC_ADMIN_TOKEN=replace-with-at-least-32-random-characters
DTC_ACCOUNTS_FILE=data/dtc/accounts.json

# Optional alternate futures contract used by the ignored dynamic multi-symbol test.
# RITHMIC_CATALOG_TEST_SYMBOL=NQZ6
# RITHMIC_CATALOG_TEST_EXCHANGE=CME
# Optional read-only US equity permission probe. Equities are not advertised
# unless search, subscription, and actual real-time data are all verified.
# RITHMIC_EQUITY_TEST_SYMBOL=AAPL

# For Live, set RITHMIC_ENV=live and provide the corresponding LIVE values:
# RITHMIC_LIVE_USER=
# RITHMIC_LIVE_PW=
# RITHMIC_LIVE_URL=
# RITHMIC_LIVE_ALT_URL=
# RITHMIC_LIVE_SYSTEM_NAME="Rithmic 01"
